// Copy to secrets.h and fill in. secrets.h is gitignored and must never be
// committed -- not once, not "temporarily". Anything that reaches git history
// is public forever as far as a credential is concerned.
#pragma once

#define WIFI_SSID     "..."
#define WIFI_PASSWORD "..."

// e.g. "cougar-count-default-rtdb.firebaseio.com" -- no scheme, no trailing slash
#define FIREBASE_HOST "..."

// Firebase console -> Project settings -> Web API key. Not a secret in the
// usual sense (it ships in web apps), but it lives here with the rest.
#define FIREBASE_API_KEY "..."

// A DEDICATED device account created in Firebase Authentication. Never a
// personal account, and never university credentials. ESP32 flash can be read
// out by anyone holding the board, so assume everything in this file is
// recoverable if the hardware is stolen -- the point is that revoking this
// account costs nothing and exposes nothing else.
#define DEVICE_EMAIL    "..."
#define DEVICE_PASSWORD "..."

// PEM root certificate for Firebase. Leave empty to skip certificate
// verification, which the firmware will do while shouting about it on serial.
// Empty is acceptable on a bench and NOT acceptable on a campus network, where
// an unverified TLS connection can be intercepted.
#define FIREBASE_ROOT_CA ""

// --- the radio link between the two boards -----------------------------------
// The exit board sends crossings to the entrance board over ESP-NOW. Encrypted,
// because a gym entrance is a public place and an unencrypted link could be
// injected into by anyone in range with twenty dollars of hardware.
//
// PEER_MAC is the OTHER board's wifi MAC. Print it once with WiFi.macAddress()
// and paste it in; each board gets the other one's.
#define ESPNOW_PEER_MAC { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }

// Exactly 16 bytes each, the same on both boards, and not these values.
#define ESPNOW_PMK "0123456789abcdef"
#define ESPNOW_LMK "fedcba9876543210"
