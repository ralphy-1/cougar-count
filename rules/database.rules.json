{
  "rules": {
    ".read": false,
    ".write": false,

    "gym": {
      "live": {
        ".read": true,

        "in_total": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() + 1 : newData.val() === 0)"
        },
        "out_total": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() + 1 : newData.val() === 0)"
        },

        "updated_at": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },

        "session_date": { ".write": false },
        "capacity":     { ".write": false },

        "$other": { ".validate": false }
      },

      "history": {
        ".read": true,
        ".write": false
      },

      "events": {
        ".read": false,
        ".write": false
      }
    }
  }
}
